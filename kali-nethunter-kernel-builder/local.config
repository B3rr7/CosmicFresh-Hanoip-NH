# local.config — overrides config, survives builder updates
# Critical fix for hanoip: kernel builds Image.gz (separate dtb partition),
# not Image.gz-dtb, so the builder must look for the right image.
IMAGE_NAME=Image.gz

# Use the .old defconfig as the build base
CONFIG=nethunter_defconfig.old

# Toolchain: zyc-clang 16 (from build-shit) as the default compiler.
# build.sh sets cc="CC=clang" when CC==clang; clang then uses the build-shit
# GCC binutils (CROSS_COMPILE below) for assembling/linking.
CC=clang
export PATH=/home/rani/hanoip-kernel/build-shit/zyc-clang/bin:/home/rani/hanoip-kernel/build-shit/gcc-arm64/bin:/home/rani/hanoip-kernel/build-shit/gcc-arm/bin:$PATH
# 32-bit VDSO needs a proper Linux ARM32 target triple for clang (the bare-metal
# arm-eabi- CROSS_COMPILE_ARM32 would otherwise yield a non-Linux object).
export CLANG_TRIPLE_ARM32=arm-linux-gnueabi-
# clang 16 escalates -Wstrict-prototypes to an error in the qcacld-3.0 vendor
# driver; downgrade it back to a warning for this 4.14 tree. Single flag, no
# spaces, so it survives unquoted Make variable passing cleanly.
MAKE_ARGS="KCFLAGS=-Wno-error=strict-prototypes"
CROSS_COMPILE=/home/rani/hanoip-kernel/build-shit/gcc-arm64/bin/aarch64-elf-
CROSS_COMPILE_ARM32=/home/rani/hanoip-kernel/build-shit/gcc-arm/bin/arm-eabi-
